<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/krem_bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Formulir donasi"
            android:textColor="@color/tinta_dark"
            android:textSize="22sp"
            android:textStyle="bold" />

        <!-- Program Donasi -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Program donasi"
            android:textColor="@color/gray_text"
            android:textSize="12sp" />

        <EditText
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="6dp"
            android:background="@color/white"
            android:enabled="false"
            android:paddingHorizontal="12dp"
            android:text="Bantuan Pendidikan"
            android:textColor="@color/tinta_dark"
            android:textSize="14sp" />

        <!-- Kategori -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Kategori"
            android:textColor="@color/gray_text"
            android:textSize="12sp" />

        <EditText
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="6dp"
            android:background="@color/white"
            android:enabled="false"
            android:paddingHorizontal="12dp"
            android:text="Donasi Pendidikan"
            android:textColor="@color/tinta_dark"
            android:textSize="14sp" />

        <!-- Jumlah Donasi -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Jumlah (Rp)"
            android:textColor="@color/gray_text"
            android:textSize="12sp" />

        <EditText
            android:id="@+id/et_jumlah_donasi"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="6dp"
            android:background="@color/white"
            android:hint="50000"
            android:inputType="number"
            android:paddingHorizontal="12dp"
            android:textColor="@color/tinta_dark"
            android:textSize="14sp" />

        <!-- Quick Nominal Buttons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal">

            <Button
                style="@style/Widget.MaterialComponents.Button.UnelevatedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:backgroundTint="#E0F2F1"
                android:text="10rb"
                android:textAllCaps="false"
                android:textColor="@color/teal_primary"
                app:cornerRadius="16dp" />

            <Button
                style="@style/Widget.MaterialComponents.Button.UnelevatedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:backgroundTint="@color/teal_primary"
                android:text="50rb"
                android:textAllCaps="false"
                android:textColor="@color/white"
                app:cornerRadius="16dp" />

            <Button
                style="@style/Widget.MaterialComponents.Button.UnelevatedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:backgroundTint="#E0F2F1"
                android:text="100rb"
                android:textAllCaps="false"
                android:textColor="@color/teal_primary"
                app:cornerRadius="16dp" />
        </LinearLayout>

        <!-- Catatan / Doa Baik -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Catatan / doa baik"
            android:textColor="@color/gray_text"
            android:textSize="12sp" />

        <EditText
            android:layout_width="match_parent"
            android:layout_height="100dp"
            android:layout_marginTop="6dp"
            android:background="@color/white"
            android:gravity="top|start"
            android:hint="Semoga bermanfaat"
            android:padding="12dp"
            android:textColor="@color/tinta_dark"
            android:textSize="14sp" />

        <!-- Tombol Lanjut -->
        <Button
            android:id="@+id/btn_lanjut_pembayaran"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="32dp"
            android:backgroundTint="@color/amber_accent"
            android:text="Lanjut ke pembayaran"
            android:textAllCaps="false"
            android:textColor="@color/tinta_dark"
            android:textStyle="bold"
            app:cornerRadius="8dp" />

    </LinearLayout>
</ScrollView>