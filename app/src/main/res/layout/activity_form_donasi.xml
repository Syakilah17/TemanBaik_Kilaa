<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="20dp"
    android:background="@color/krem_bg">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Formulir Donasi"
        android:textColor="@color/tinta_dark"
        android:textSize="20sp"
        android:textStyle="bold" />

    <!-- Input Nominal Donasi -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="Masukkan Nominal Donasi (Rp)"
        android:textColor="@color/gray_text"
        android:textSize="13sp" />

    <EditText
        android:id="@+id/et_nominal_donasi"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginTop="8dp"
        android:background="@color/white"
        android:hint="Contoh: 50000"
        android:inputType="number"
        android:paddingHorizontal="16dp"
        android:textSize="15sp" />

    <!-- Tampilan Hitung Otomatis (Total + Kode Unik Rp7) -->
    <TextView
        android:id="@+id/tv_total_bayar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:background="#E8F5E9"
        android:padding="14dp"
        android:text="Total Pembayaran: Rp 0"
        android:textColor="@color/teal_primary"
        android:textSize="16sp"
        android:textStyle="bold" />

    <!-- Tombol Lanjut Pembayaran -->
    <Button
        android:id="@+id/btn_lanjut_bayar"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginTop="24dp"
        android:backgroundTint="@color/teal_primary"
        android:text="Lanjutkan Pembayaran"
        android:textAllCaps="false"
        android:textColor="@color/white"
        android:textSize="15sp"
        android:textStyle="bold"
        app:cornerRadius="8dp" />

</LinearLayout>