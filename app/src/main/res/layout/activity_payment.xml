<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/krem_bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Konfirmasi pembayaran"
            android:textColor="@color/tinta_dark"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Scan QRIS dan bayar tepat sejumlah"
            android:textColor="@color/gray_text"
            android:textSize="12sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Rp 50.000"
            android:textColor="@color/teal_primary"
            android:textSize="24sp"
            android:textStyle="bold" />

        <!-- Area Frame QR Code -->
        <androidx.cardview.widget.CardView
            android:layout_width="200dp"
            android:layout_height="200dp"
            android:layout_marginTop="20dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="2dp">

            <!-- Menggunakan ImageView untuk menampilkan ikon/gambar QR Code -->
            <ImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_margin="16dp"
                android:scaleType="fitCenter"
                android:src="@android:drawable/ic_menu_report_image"
                app:tint="@color/teal_primary" />
        </androidx.cardview.widget.CardView>

        <!-- Tombol Unggah Bukti Transfer -->
        <Button
            android:id="@+id/btn_upload_proof"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="24dp"
            android:text="+ Unggah bukti transfer"
            android:textAllCaps="false"
            android:textColor="@color/teal_primary"
            app:cornerRadius="8dp"
            app:strokeColor="@color/teal_primary" />

        <!-- Petunjuk Cara Bayar -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:cardBackgroundColor="#F0F4F3"
            app:cardCornerRadius="12dp"
            app:cardElevation="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Cara bayar"
                    android:textColor="@color/tinta_dark"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:lineSpacingExtra="2dp"
                    android:text="• Scan QRIS dengan e-wallet atau m-banking\n• Pastikan nominal sesuai\n• Simpan bukti bayar dan unggah di sini"
                    android:textColor="@color/gray_text"
                    android:textSize="11sp" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Tombol Konfirmasi & Kirim -->
        <Button
            android:id="@+id/btn_confirm_payment"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="24dp"
            android:backgroundTint="@color/amber_accent"
            android:text="Konfirmasi &amp; kirim donasi"
            android:textAllCaps="false"
            android:textColor="@color/tinta_dark"
            android:textStyle="bold"
            app:cornerRadius="8dp" />

        <TextView
            android:id="@+id/tv_ubah_donasi"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Ubah data donasi"
            android:textColor="@color/teal_primary"
            android:textSize="12sp"
            android:textStyle="bold" />

    </LinearLayout>
</ScrollView>