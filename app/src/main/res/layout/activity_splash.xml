<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8F5EC"
    android:gravity="center">

    <!-- Grup Logo dan Teks di Tengah Vertikal -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical">

        <!-- Logo: Persegi Teal Membulat -->
        <androidx.cardview.widget.CardView
            android:layout_width="100dp"
            android:layout_height="100dp"
            app:cardBackgroundColor="#14665A"
            app:cardCornerRadius="20dp"
            app:cardElevation="0dp">

            <!-- Ikon Hati Oranye di Dalam Persegi -->
            <ImageView
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_heart_orange" />

        </androidx.cardview.widget.CardView>

        <!-- Teks: Teman Baik (Tebal) -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Teman Baik"
            android:textColor="#12302B"
            android:textSize="36sp"
            android:textStyle="bold" />

        <!-- Teks: Rasa peduli untuk sesama (Tipis) -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Rasa peduli untuk sesama"
            android:textColor="#757575"
            android:textSize="14sp" />

    </LinearLayout>

</RelativeLayout>