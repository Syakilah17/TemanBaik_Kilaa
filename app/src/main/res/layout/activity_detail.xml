<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="20dp"
    android:background="@color/krem_bg">

    <!-- Judul Donasi -->
    <TextView
        android:id="@+id/tv_detail_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Bantuan Bencana Banjir"
        android:textColor="@color/tinta_dark"
        android:textSize="20sp"
        android:textStyle="bold" />

    <!-- Deskripsi Singkat -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Mari bersama membantu saudara kita yang terdampak bencana alam."
        android:textColor="@color/gray_text"
        android:textSize="14sp" />

    <!-- Tombol Bagikan Program Donasi (Fitur Share) -->
    <Button
        android:id="@+id/btn_share_donasi"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginTop="28dp"
        android:backgroundTint="@color/teal_primary"
        android:text="Bagikan Program Ini"
        android:textAllCaps="false"
        android:textColor="@color/white"
        android:textSize="15sp"
        android:textStyle="bold"
        app:cornerRadius="8dp" />

</LinearLayout>