<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/krem_bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Gambar Banner Program Sekolah -->
        <ImageView
            android:layout_width="match_parent"
            android:layout_height="220dp"
            android:scaleType="centerCrop"
            android:src="@drawable/sekolah" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- Tag Kategori -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="#E0F2F1"
                android:paddingHorizontal="12dp"
                android:paddingVertical="4dp"
                android:text="Pendidikan"
                android:textColor="@color/teal_primary"
                android:textSize="12sp"
                android:textStyle="bold" />

            <!-- Judul Program -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Bantuan Pendidikan Anak Pedalaman"
                android:textColor="@color/tinta_dark"
                android:textSize="20sp"
                android:textStyle="bold" />

            <!-- Progress Bar -->
            <ProgressBar
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="8dp"
                android:layout_marginTop="16dp"
                android:progress="45"
                android:progressTint="@color/amber_accent" />

            <!-- Jumlah Dana -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Rp4.500.000"
                android:textColor="@color/teal_primary"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="terkumpul dari Rp10.000.000"
                android:textColor="@color/gray_text"
                android:textSize="12sp" />

            <!-- Deskripsi -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:lineSpacingExtra="4dp"
                android:text="Membantu anak-anak di pedalaman mendapatkan akses buku dan alat tulis yang layak."
                android:textColor="@color/tinta_dark"
                android:textSize="14sp" />

            <!-- Tombol Aksi -->
            <Button
                android:id="@+id/btn_donasi_detail"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="32dp"
                android:backgroundTint="@color/amber_accent"
                android:text="Donasi sekarang"
                android:textAllCaps="false"
                android:textColor="@color/tinta_dark"
                android:textStyle="bold"
                app:cornerRadius="8dp" />

            <Button
                android:id="@+id/btn_daftar_relawan"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="8dp"
                android:text="Daftar relawan"
                android:textAllCaps="false"
                android:textColor="@color/teal_primary"
                app:cornerRadius="8dp"
                app:strokeColor="@color/teal_primary" />

        </LinearLayout>
    </LinearLayout>
</ScrollView>